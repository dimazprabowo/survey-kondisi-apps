APP_NAME="Portal SSO Client"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Auth Layout (login/guest page panel position: left | center | right)
# Invalid values fall back to "center"
LOGIN_POSITION=center

# SSO Server Configuration
# Set to true to enable SSO integration, false to run as standalone app
IS_USING_SSO=true
# OAuth credentials — diperoleh saat mendaftarkan app di SSO Server
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Base URL SSO Server (tanpa trailing slash)
SSO_BASE_URL=http://localhost:8111
# Callback URL setelah OAuth login (harus cocok dengan redirect_uri di SSO Server)
SSO_REDIRECT_URI=http://localhost:8999/auth/callback
# Shared secret untuk autentikasi API sync (harus sama dengan api_secret_key di SSO Server)
SSO_API_SECRET=
# Set to false jika SSL certificate belum valid (self-signed, chain incomplete, dll)
SSO_VERIFY_SSL=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3 / S3-compatible storage (AWS S3, DigitalOcean Spaces, MinIO)
# Set FILESYSTEM_DISK=s3 above to use this for file storage
# For DigitalOcean Spaces: set AWS_ENDPOINT to your Spaces URL and AWS_USE_PATH_STYLE_ENDPOINT=false
# For MinIO: set AWS_ENDPOINT to your MinIO URL and AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google reCAPTCHA
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Laravel Reverb (WebSocket Server)
REVERB_APP_ID=1001
REVERB_APP_KEY=laravel-reverb-key
REVERB_APP_SECRET=laravel-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# OnlyOffice Document Server (edit Word di browser)
ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=
ONLYOFFICE_JWT_SECRET=
